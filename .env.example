# Copy to .env — docker compose reads it for ${VAR} interpolation.
RELAY_API_TOKEN=relay-demo-token

# AI provider: heuristic (offline, no key — the default) | openrouter
# To use a real model: set RELAY_AI_PROVIDER=openrouter and paste your OpenRouter key.
RELAY_AI_PROVIDER=heuristic
OPENROUTER_API_KEY=
RELAY_AI_MODEL=openai/gpt-4o-mini

# Durability drill only (leave empty): crash_after_side_effect:create_shipment
RELAY_FAULTS=
